    {
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "count(upm_component_status{status=\"ok\",stale=\"false\"}) or vector(0)", "instant": true, "refId": "A" }],
      "title": "OK",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "count(upm_component_status{status=\"outdated\"}) or vector(0)", "instant": true, "refId": "A" }],
      "title": "Outdated",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "gray", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "count(upm_component_status{status=\"unknown\"}) or vector(0)", "instant": true, "refId": "A" }],
