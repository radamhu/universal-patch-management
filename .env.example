PVE01_HOST=
PVE01_HOST_USER=root@pam
PVE01_HOST_TOKEN=
PVE01_HOST_TOKEN_SECRET=
# optional: user for `pct exec` probes over SSH on the PVE host
PVE01_SSH_USER=root
# non-pve SSH hosts (OS/docker/backup) are configured in components.json under "hosts";
# components.json values may reference ${VAR_NAME} placeholders expanded from these:
ORACLE_SSH_HOST_1=
ORACLE_SSH_USER_1=ubuntu
POLL_INTERVAL=30
# PVE_VERIFY_TLS=false  (set true to verify the Proxmox TLS certificate)
# BACKUP_MAX_AGE_H=36
# PORT=8080
# DATA_DIR=/data
# SSH_KEY_PATH=/run/secrets/upm_ssh_key
# KNOWN_HOSTS_PATH=/data/known_hosts
# UPM_UID=1000  (compose only: build arg; must own secrets/id_ed25519)
